# Database Connection (Supabase PostgreSQL)
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/database
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase API (for Storage and Auth if needed)
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Cron Job Secret (for automated follow-up reminders)
CRON_SECRET=your-secure-cron-secret-change-in-production

# Maps Configuration (Optional - for future Mapbox/Google Maps integration)
# NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Environment
NODE_ENV=development

# NextAuth.js Configuration
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-generate-with-openssl-rand-base64-32

# Optional: OAuth Providers (for future)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
